{
  "name": "geek-protocol-hq",
  "version": "0.1.0",
  "description": "Security-first Proof-of-Learning and trivia platform for the Kaspa ecosystem.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://www.geekprotocol.xyz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GEEKProtocol0110/geek-protocol-hq.git"
  },
  "bugs": {
    "url": "https://github.com/GEEKProtocol0110/geek-protocol-hq/issues"
  },
  "keywords": [
    "kaspa",
    "krc-20",
    "proof-of-learning",
    "trivia",
    "web3"
  ],
  "scripts": {
    "test": "node --test",
    "test:signer": "npm --prefix workers/testnet run check",
    "recovery:drill": "node --test tests/recovery.test.js",
    "security:check": "node scripts/public-answer-check.mjs && node scripts/security-check.mjs",
    "collection:generate": "node scripts/generate-geek-collection.mjs",
    "collection:check": "node scripts/check-geek-collection.mjs",
    "archive:generate": "node scripts/generate-legacy-art-archive.mjs",
    "archive:check": "node scripts/check-legacy-art-archive.mjs",
    "repository:check": "node scripts/check-repository-presentation.mjs",
    "verify": "npm test && npm run test:signer && npm run questions:check && npm run collection:check && npm run archive:check && npm run security:check && npm run repository:check && npm run economy:stress:check && npm run continuity:check && npm run site:check",
    "questions:check": "node scripts/check-question-banks.mjs && node scripts/question-catalog.mjs && node scripts/question-bank-readiness.mjs && npm run questions:audit",
    "questions:catalog": "node scripts/question-catalog.mjs --write",
    "monitor:production": "node scripts/production-monitor.mjs",
    "economy:stress": "node scripts/economy-stress.mjs",
    "economy:stress:check": "node scripts/economy-stress.mjs --check",
    "continuity:write": "node scripts/continuity.mjs --write",
    "continuity:check": "node scripts/continuity.mjs",
    "continuity:snapshot": "node scripts/continuity-snapshot.mjs",
    "site:write": "node scripts/site-pages.mjs --write",
    "site:check": "node scripts/site-pages.mjs",
    "performance:baseline": "node scripts/performance-baseline.mjs",
    "questions:audit": "node scripts/audit-question-banks.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dfns/kaspa-wasm": "0.14.1",
    "@simplewebauthn/server": "14.0.3",
    "ai": "7.0.143"
  }
}
