        "ARGENT"
      ]
    },
    {
      "id": "KCC-F03",
      "classification": "derived-arithmetic",
      "claim": "144 billion at eight decimals exceeds the checked reference single-minter int range; this does not prove aggregate multi-state supply is universally impossible.",
      "sources": [
        "ARGENT",
        "ARGENT-MINT"
      ],
      "localEvidence": [
        "server/geek-deployment.js"
      ]
    },
    {
      "id": "KCC-F04",
      "classification": "source-fact-and-integration-limit",
      "claim": "Snapshot builders use synthetic funded tests and leave funded DEV rehearsal, independent review and source acceptance to the host. They do not establish a trustless GEEK migration.",
      "sources": [
        "SNAPSHOT",
        "BUILDER-LOCK"
      ]
    },
    {
      "id": "KCC-F05",
      "classification": "geek-design-analysis",
      "claim": "Snapshot claims alone leave old tokens spendable. Open mint, post-cutoff transfers, duplicate entitlements, custody holders, precision and unclaimed reserves require explicit policy.",
      "sources": []
    },
    {
      "id": "KCC-F06",
      "classification": "geek-design-analysis",
      "claim": "Covenants can constrain authorized token spending; they cannot independently verify honest learning or replace funded reward, identity and appeal rules.",
      "sources": [
        "KCC20",
        "KCC2"
      ]
    },
    {
      "id": "KCC-F07",
      "classification": "source-fact",
      "claim": "Token Depot v1.2 is a separate community-review proposal, not an accepted ecosystem KCC or a replacement for kaspanet ABI.",
