{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/appearance",
      "destination": "/api/session?service=appearance"
    },
    {
      "source": "/api/appearance/",
      "destination": "/api/session?service=appearance"
    },
    {
      "source": "/api/royale",
      "destination": "/api/lobbies?service=royale"
    },
    {
      "source": "/api/royale/",
      "destination": "/api/lobbies?service=royale"
    },
    {
      "source": "/ops",
      "destination": "/api/session?service=operations"
    },
    {
      "source": "/ops/",
      "destination": "/api/session?service=operations"
    },
    {
      "source": "/ops/questions",
      "destination": "/api/session?service=operations&path=questions"
    },
    {
      "source": "/ops/questions/",
      "destination": "/api/session?service=operations&path=questions"
    },
    {
      "source": "/ops/activity",
      "destination": "/api/session?service=operations&path=activity"
    },
    {
      "source": "/ops/activity/",
      "destination": "/api/session?service=operations&path=activity"
    },
    {
      "source": "/ops/payouts",
      "destination": "/api/session?service=operations&path=payouts"
    },
    {
      "source": "/ops/payouts/",
      "destination": "/api/session?service=operations&path=payouts"
    },
    {
      "source": "/ops/appearance",
      "destination": "/api/session?service=operations&path=appearance"
    },
    {
      "source": "/ops/appearance/",
      "destination": "/api/session?service=operations&path=appearance"
    },
    {
      "source": "/ops/:path*",
      "destination": "/api/session?service=operations&path=:path*"
    },
    {
      "source": "/api/quest",
      "destination": "/api/ranked?service=quest"
    },
    {
      "source": "/api/quest/",
      "destination": "/api/ranked?service=quest"
    },
    {
      "source": "/api/duel",
      "destination": "/api/lobbies?service=duel"
    },
    {
      "source": "/api/duel/",
      "destination": "/api/lobbies?service=duel"
    },
    {
      "source": "/api/profile",
      "destination": "/api/session?service=profile"
    },
    {
      "source": "/api/profile/",
      "destination": "/api/session?service=profile"
    },
    {
      "source": "/api/collectibles",
      "destination": "/api/session?service=collectibles"
    },
    {
      "source": "/api/collectibles/",
      "destination": "/api/session?service=collectibles"
    }
  ],
  "functions": {
    "api/mint.js": {
      "maxDuration": 30
    },
    "api/identity.js": {
      "includeFiles": "node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm"
    },
    "api/ranked.js": {
      "includeFiles": "{server/questions/**,node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm}"
    },
    "api/lobbies.js": {
      "includeFiles": "{server/questions/**,node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm}"
    },
    "api/session.js": {
      "includeFiles": "{server/ops-ui/**,node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm}"
    },
    "api/leaderboard.js": {
      "includeFiles": "node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm"
    },
    "api/content.js": {
      "includeFiles": "node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm"
    },
    "api/rewards.js": {
      "includeFiles": "node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src https://kgi.kaspad.net; form-action 'self'; script-src 'self' 'sha256-z4nhfmSCNrXFiKv3iMJVPjFv5lrk3ueDGEn5lnOcZpg='; style-src 'self'; img-src 'self' data:; connect-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/moderate",
      "destination": "/ops/",
      "permanent": false
    },
    {
      "source": "/moderate/",
      "destination": "/ops/",
      "permanent": false
    },
    {
      "source": "/moderate/:path*",
      "destination": "/ops/",
      "permanent": false
    }
  ]
}
