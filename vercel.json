{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/profile", "destination": "/api/session?service=profile" },
    { "source": "/api/profile/", "destination": "/api/session?service=profile" },
    { "source": "/api/collectibles", "destination": "/api/session?service=collectibles" },
    { "source": "/api/collectibles/", "destination": "/api/session?service=collectibles" }
  ],
  "functions": {
    "api/mint.js": {
      "maxDuration": 30
    },
    "api/identity.js": {
      "includeFiles": "node_modules/@dfns/kaspa-wasm/kaspa_bg.wasm"
    },
    "api/ranked.js": {
      "includeFiles": "server/questions/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-z4nhfmSCNrXFiKv3iMJVPjFv5lrk3ueDGEn5lnOcZpg='; style-src 'self'; img-src 'self' data:; connect-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
