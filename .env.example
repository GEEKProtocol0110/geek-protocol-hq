# Persistent state for sessions, ranked play, profiles, lobbies, and review queues.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-local-development-token

# Community Content Engine moderation. Use a unique random value of 24+ characters.
CCE_ADMIN_TOKEN=replace-with-dedicated-moderator-token
CCE_REWARD_AMOUNT=25

# Audit evidence. Production requires a unique random secret of 32+ characters.
AUDIT_LOG_SECRET=replace-with-audit-integrity-secret
AUDIT_KEY_ID=local-development-key
AUDIT_ADMIN_TOKEN=replace-with-dedicated-audit-export-token

# Payout review must use a credential that is separate from moderation and audit export.
PAYOUT_REVIEW_ADMIN_TOKEN=replace-with-dedicated-payout-review-token

# Optional additional HTTPS origins for non-production identity deployments.
# IDENTITY_ALLOWED_ORIGINS=https://preview.example.com
# IDENTITY_ORIGIN=https://legacy-preview.example.com
# IDENTITY_ENV=local-development

# Optional dedicated Operations owner key. While absent, CCE_ADMIN_TOKEN grants the full owner session.
# Set a separate 24+ character OPS_ACCESS_TOKEN before giving anyone a moderator key.
# OPS_ACCESS_TOKEN=replace-with-private-owner-access-key
# Optional exact HTTPS origins for separately hosted Operations previews.
# OPS_ALLOWED_ORIGINS=https://preview.example.com

# Isolated owner testnet pilot; never enables Mainnet settlement or automatic signing.
# All fields are required before enabling. Pin a real testnet deployment, not the Mainnet GEEK hash.
TESTNET_REWARDS_ENABLED=false
# Optional bounded automatic pilot admission: operator-approved TN10 addresses.
# Verified wallet holders need no player enrollment form; empty disables this path.
# TESTNET_AUTO_APPROVED_WALLETS=kaspatest:<approved recipient>,kaspatest:<another recipient>
# TESTNET_REWARDS_NETWORK=testnet-10
# TESTNET_REWARDS_TICKER=GEEK
# TESTNET_REWARDS_DEPLOYMENT_HASH=<64 lowercase hex characters>
# TESTNET_REWARDS_DECIMALS=8
# TESTNET_REWARDS_SENDER=kaspatest:<approved test-wallet address>
# TESTNET_REWARDS_AMOUNT_RAW=100000000
